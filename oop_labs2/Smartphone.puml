@startuml

title UML-диаграмма класса Smartphone (Вариант 10)

class Battery <<struct>> {
    + level : int
    + capacity : int
}

class Smartphone {
    - model : string
    - memory : int
    - isPoweredOn : bool
    - battery : Battery
    - {static} objectCount : int

    - validateModel(model : string) : void
    - validateMemory(memory : int) : void
    - validateBattery(battery : Battery) : void

    + Smartphone()
    + Smartphone(model : string, memory : int, battery : Battery, isPoweredOn : bool)
    + Smartphone(model : string, memory : int)
    + ~Smartphone()

    + getModel() : string
    + getMemory() : int
    + getBatteryLevel() : int
    + getBatteryCapacity() : int
    + isOn() : bool

    + turnOn() : void
    + turnOff() : void
    + charge(amount : int) : void
    + useBattery(amount : int) : bool

    + printInfo() : void
    + {static} getObjectCount() : int
}

Smartphone *-- Battery : содержит

@enduml